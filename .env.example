# Reference only: nothing reads this file. Configure these values in each repository under
# Settings → Secrets and variables → Actions. Never commit real credentials (.env is git-ignored).

# --- Secrets (tab "Secrets") ---------------------------------------------------------------
# Brevo → SMTP & API → SMTP: the "Login" shown there (not your account e-mail).
BREVO_SMTP_LOGIN=123abc001@smtp-brevo.com
# Brevo → SMTP & API → SMTP → "Generate a new SMTP key" (an SMTP key, NOT an API key).
BREVO_SMTP_KEY=xsmtpsib-REPLACE-ME

# --- Variables (tab "Variables") -----------------------------------------------------------
# Opt-in switch: anything other than "true" sends nothing and starts no runner.
NOTIFICATION_ENABLED=true
# Comma-separated recipients (max 50). Each recipient counts as 1 e-mail of the Brevo quota.
NOTIFICATION_EMAILS=dev@example.com,pm@example.com
# Sender verified in Brevo: "address" or "Display name <address>".
NOTIFICATION_FROM=GitHub Notifications <notifications@example.com>
# Optional. Comma-separated branch names or globs (push target / PR base). Default: main,master
NOTIFICATION_BRANCHES=main,master
# Optional. Any of: push, pr_opened, pr_merged, pr_closed. Default: push,pr_opened,pr_merged
NOTIFICATION_EVENTS=push,pr_opened,pr_merged
